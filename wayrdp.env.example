# wayRDP Server Configuration
# Copy this file to ~/.config/wayrdp.env and customize it.

# Server listening port (default: 3390, keeps 3389 free for official KRdp)
RDP_PORT=3390

# Fixed RDP password (strongly recommended for Windows mstsc client compatibility)
# Windows Remote Desktop (mstsc.exe) requires Network Level Authentication (NLA) or an explicit password.
# Setting RDP_PASSWORD enables native Windows Security credential prompts for mstsc clients.
# Leave commented out to authenticate using your Linux system PAM password via TLS.
# RDP_PASSWORD=your_secure_password

# Hardware Video Encoder Backend
# Options:
#   vaapi   (Intel / AMD GPU hardware acceleration - default)
#   nvenc   (NVIDIA GPU hardware acceleration)
#   x264    (CPU software encoding fallback)
RDP_ENCODER=vaapi

# Video Codec Profile
# Options:
#   h264_baseline (Standard baseline, compatible with all legacy RDP clients)
#   h264_main     (H.264 Main profile with CABAC & 8x8 transform - much sharper text - default)
#   vp8           (VP8 video stream)
#   vp9           (VP9 video stream)
RDP_CODEC=h264_main

# Video Encoding Quality: 30 to 100 (95 provides razor-sharp text and visually lossless UI)
RDP_QUALITY=95

# Hardware Encoder Latency & Pipeline Preference
# Options:
#   speed   (enforces async_depth=1 in VA-API and -tune zerolatency in x264 - default)
#   quality (may buffer frames in GPU pipeline, causing closing window ghosting)
#   size    (optimizes bitrate at cost of encoder pipeline depth)
RDP_ENCODER_PREFERENCE=speed

# Idle Power Saver:
# Automatically throttles framerate to 5 FPS after N seconds of no client input.
# Resumes full framerate instantly on mouse move or keypress. Set to 0 to disable.
RDP_IDLE_TIMEOUT_SEC=30

# Session Auto-Lock on Disconnect:
# Set to 1 to lock the KDE session (via KScreenLocker) when the RDP client disconnects.
RDP_LOCK_ON_DISCONNECT=1

# ==============================================================================
# Input Settings Overrides
# Note: wayrdp automatically reads and hot-reloads touchpad natural scrolling,
# scroll speed, left-handed mode, and cursor size directly from KDE Plasma
# System Settings (kcminputrc / kdeglobals). Only uncomment below if you wish
# to override your local KDE system settings.
# ==============================================================================

# Explicitly override touchpad natural scrolling (1 = natural/inverted, 0 = traditional)
# RDP_NATURAL_SCROLL=1

# Scroll Speed Multiplier:
# Leave commented out to automatically use KDE Plasma system settings (ScrollFactor).
# Set to an explicit double (e.g. 0.083) to override system settings.
# RDP_SCROLL_SCALE=0.083

# Windows Client Scroll Multiplier:
# Windows mstsc sends 120-unit wheel detents per packet, which can feel much faster than macOS.
# Defaults to 0.5 (halving Windows scroll speed so it feels identical to macOS).
# Adjust to 0.4 for even slower, or 0.6-0.7 for faster. Mac clients always use 1.0.
# RDP_WINDOWS_SCROLL_SCALE=0.5

# Directional Inversions:
# Set to 1 to explicitly invert scroll directions:
# RDP_INVERT_SCROLL=1
# RDP_INVERT_HSCROLL=1
# RDP_INVERT_VSCROLL=1

# Left-Handed Mouse Mapping:
# Leave commented out to inherit KDE Plasma system settings (kcminputrc).
# Set to 1 to swap left and right mouse buttons.
# RDP_LEFT_HANDED=1

